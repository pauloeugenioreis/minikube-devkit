# Normalize text files and keep script line endings stable across platforms.
* text=auto eol=lf

# Shell scripts must use LF or they break on Linux/macOS.
*.sh   text eol=lf
*.env  text eol=lf
Makefile text eol=lf

# PowerShell scripts use CRLF, the native Windows convention.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

*.png binary
*.gif binary
