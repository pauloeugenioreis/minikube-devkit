# minikube-devkit default configuration.
#
# This is the single configuration file of the project and it is committed.
# Edit it directly; the setup wizard also saves your answers here.
# For a one-off override, set an environment variable with the same name
# (e.g. DEVKIT_CPUS=6 ./devkit.sh doctor); it takes precedence over this file.
#
# Format: KEY=value, one per line. No variable expansion and no inline
# comments (everything after the first "=" is the value).

# ---- Cluster ----
DEVKIT_PROFILE=devkit
DEVKIT_DRIVER=docker
DEVKIT_KUBERNETES_VERSION=stable
DEVKIT_CPUS=4
DEVKIT_MEMORY_MB=8192
DEVKIT_DISK_GB=40
DEVKIT_MIN_CPUS=2
DEVKIT_MIN_MEMORY_MB=4096
DEVKIT_MIN_DISK_GB=20

# ---- Tool versions ----
# *_VERSION is installed when the tool is missing or older than *_MIN_VERSION.
DEVKIT_MINIKUBE_VERSION=v1.38.1
DEVKIT_MINIKUBE_MIN_VERSION=v1.34.0
DEVKIT_KUBECTL_VERSION=v1.35.3
DEVKIT_KUBECTL_MIN_VERSION=v1.30.0
DEVKIT_HELM_VERSION=v3.20.1
DEVKIT_HELM_MIN_VERSION=v3.12.0
DEVKIT_DOCKER_MIN_VERSION=20.10.0

# Where CLI binaries are installed on Linux/macOS.
# Windows always uses %LOCALAPPDATA%\minikube-devkit\bin.
DEVKIT_BIN_DIR=/usr/local/bin

# macOS only: Docker runtime installed for the docker driver (desktop | colima).
DEVKIT_DOCKER_RUNTIME_MACOS=desktop

# Seconds to wait for a Docker daemon to become ready after starting it.
DEVKIT_DOCKER_START_TIMEOUT=180

# ---- Components (true | false) ----
DEVKIT_INSTALL_DASHBOARD=true
DEVKIT_INSTALL_RABBITMQ=true
DEVKIT_INSTALL_MONGODB=true
DEVKIT_INSTALL_POSTGRESQL=true
DEVKIT_INSTALL_MYSQL=true
DEVKIT_INSTALL_REDIS=true
DEVKIT_INSTALL_KEDA=true

# ---- Kubernetes ----
# Namespace for the data services (RabbitMQ, MongoDB, PostgreSQL, MySQL, Redis).
DEVKIT_NAMESPACE=devkit-data
# Seconds to wait for each component to become ready (first run pulls images).
DEVKIT_DEPLOY_TIMEOUT=600

# Container images. Note: databases are initialized only on the first start;
# changing a major version later may require "reset" of that service.
DEVKIT_IMAGE_RABBITMQ=rabbitmq:4.2-management-alpine
# MongoDB 8.0 refuses to start on Linux kernels >= 6.19 (SERVER-121912); 8.2 works.
DEVKIT_IMAGE_MONGODB=mongo:8.2
DEVKIT_IMAGE_POSTGRESQL=postgres:18-alpine
DEVKIT_IMAGE_MYSQL=mysql:8.4
DEVKIT_IMAGE_REDIS=redis:8.2-alpine

# KEDA Helm chart version (https://github.com/kedacore/charts).
DEVKIT_KEDA_CHART_VERSION=2.21.0

# ---- Local ports (port-forward targets) ----
DEVKIT_PORT_DASHBOARD=15671
DEVKIT_PORT_RABBITMQ_MGMT=15672
DEVKIT_PORT_RABBITMQ_AMQP=5672
DEVKIT_PORT_MONGODB=27017
DEVKIT_PORT_POSTGRESQL=5432
DEVKIT_PORT_MYSQL=3306
DEVKIT_PORT_REDIS=6379

# ---- Development credentials (NEVER use these in production) ----
DEVKIT_RABBITMQ_USER=guest
DEVKIT_RABBITMQ_PASSWORD=guest
DEVKIT_MONGODB_USER=devkit
DEVKIT_MONGODB_PASSWORD=devkit
DEVKIT_MONGODB_DATABASE=devkit
DEVKIT_POSTGRESQL_USER=devkit
DEVKIT_POSTGRESQL_PASSWORD=devkit
DEVKIT_POSTGRESQL_DATABASE=devkit
DEVKIT_MYSQL_USER=devkit
DEVKIT_MYSQL_PASSWORD=devkit
DEVKIT_MYSQL_ROOT_PASSWORD=devkit
DEVKIT_MYSQL_DATABASE=devkit
DEVKIT_REDIS_PASSWORD=devkit
